{
  "enabledPlugins": {
    "savvy-progress@mods-do-caio": true,
    "escolha-de-modelo@mods-do-caio": true
  },
  "extraKnownMarketplaces": {
    "mods-do-caio": {
      "source": {
        "source": "directory",
        "path": "./.claude/mods-do-caio"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
